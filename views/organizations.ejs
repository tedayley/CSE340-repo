<%- include("partials/header", { title }) %>

<section class="page-banner">
    <div class="container">

        <p class="eyebrow">Our community</p>

        <h1>Organizations</h1>

        <p>
            Meet organizations creating positive change through service.
        </p>

    </div>
</section>

<section class="section">
    <div class="container">

        <div class="organization-grid">

            <article class="organization-card">

                <img
                    src="/images/community.svg"
                    alt="Illustration representing community service"
                >

                <div class="organization-content">

                    <span class="tag">
                        Community
                    </span>

                    <h2>
                        Community Connect
                    </h2>

                    <p>
                        Brings volunteers together to support local
                        neighborhoods through hands-on service.
                    </p>

                </div>

            </article>

            <article class="organization-card">

                <img
                    src="/images/education.svg"
                    alt="Illustration representing educational service"
                >

                <div class="organization-content">

                    <span class="tag">
                        Education
                    </span>

                    <h2>
                        Learning Partners
                    </h2>

                    <p>
                        Provides tutoring, mentoring, and educational
                        resources for students in the community.
                    </p>

                </div>

            </article>

            <article class="organization-card">

                <img
                    src="/images/environment.svg"
                    alt="Illustration representing environmental service"
                >

                <div class="organization-content">

                    <span class="tag">
                        Environment
                    </span>

                    <h2>
                        Green Future
                    </h2>

                    <p>
                        Coordinates projects that protect local parks,
                        waterways, and natural spaces.
                    </p>

                </div>

            </article>

        </div>

    </div>
</section>

<%- include("partials/footer") %>