<%- include("partials/header", { title }) %>

<section class="page-banner">
    <div class="container">
        <p class="eyebrow">Community Organization</p>
        <h1><%= organization.name %></h1>
        <p>
            Learn more about this organization and the service
            projects it supports.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">

        <article class="organization-card">
            <img
                src="/images/<%= organization.logo_filename %>"
                alt="<%= organization.name %> logo"
            >

            <div class="organization-content">
                <span class="tag">
                    Community Organization
                </span>

                <h2><%= organization.name %></h2>

                <p>
                    <%= organization.description %>
                </p>

                <p>
                    <strong>Contact:</strong>
                    <%= organization.contact_email %>
                </p>
            </div>
        </article>

        <h2>Service Projects</h2>

        <div class="project-list">
<% projects.forEach((project, index) => { %>
            <article class="project-card">
                <div class="project-number">
                    <%= String(index + 1).padStart(2, "0") %>
                </div>

                <div>
                    <h3>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h3>

                    <p>
                        <%= project.description %>
                    </p>

                    <p class="project-meta">
                        <%= project.date.toLocaleDateString("en-US", {
                            weekday: "long",
                            month: "long",
                            day: "numeric",
                            year: "numeric"
                        }) %>
                        &bull;
                        <%= project.location %>
                    </p>
                </div>
            </article>
<% }) %>
        </div>

    </div>
</section>

<%- include("partials/footer") %>