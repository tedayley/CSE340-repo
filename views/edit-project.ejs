<%- include("partials/header", { title: "Edit Service Project" }) %>

<h1>Edit Service Project</h1>

<form class="edit-project-form" action="/edit-project/<%= project.project_id %>" method="POST">

    <label for="title">Project Title</label>
    <input
        type="text"
        id="title"
        name="title"
        value="<%= project.title %>"
        required
    >

    <label for="description">Description</label>
    <textarea
        id="description"
        name="description"
        required
    ><%= project.description %></textarea>

    <label for="location">Location</label>
    <input
        type="text"
        id="location"
        name="location"
        value="<%= project.location %>"
        required
    >

    <label for="date">Date</label>
    <input
        type="date"
        id="date"
        name="date"
        value="<%= project.date.toISOString().split('T')[0] %>"
        required
    >

    <label for="organization_id">Organization</label>
    <select
        id="organization_id"
        name="organization_id"
        required
    >
        <% organizations.forEach(organization => { %>
            <option
                value="<%= organization.organization_id %>"
                <%= organization.organization_id == project.organization_id ? "selected" : "" %>
            >
                <%= organization.name %>
            </option>
        <% }) %>
    </select>

    <button type="submit">Update Project</button>

</form>

<%- include("partials/footer") %>