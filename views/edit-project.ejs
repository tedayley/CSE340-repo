<%- include("partials/header", { title: "Edit Service Project" }) %>

<div class="container">
<form class="edit-project-form" action="/edit-project/<%= project.project_id %>" method="POST">

    <h1>Edit Service Project</h1>

    <% if (typeof error !== "undefined") { %>
        <p class="form-error" role="alert"><%= error %></p>
    <% } %>

    <label for="title">Project Title</label>
    <input
        type="text"
        id="title"
        name="title"
        value="<%= project.title %>"
        minlength="3"
        maxlength="150"
        required
    >

    <label for="description">Description</label>
    <textarea
        id="description"
        name="description"
        minlength="10"
        required
    ><%= project.description %></textarea>

    <label for="location">Location</label>
    <input
        type="text"
        id="location"
        name="location"
        value="<%= project.location %>"
        minlength="2"
        maxlength="255"
        required
    >

    <label for="date">Date</label>
    <input
        type="date"
        id="date"
        name="date"
        value="<%= project.date instanceof Date ? project.date.toISOString().slice(0, 10) : String(project.date).slice(0, 10) %>"
        required
    >

    <label for="organization_id">Organization</label>
    <select
        id="organization_id"
        name="organization_id"
        required
    >
        <% organizations.forEach(organization => { %>
            <option
                value="<%= organization.organization_id %>"
                <%= organization.organization_id == project.organization_id ? "selected" : "" %>
            >
                <%= organization.name %>
            </option>
        <% }) %>
    </select>

    <button type="submit">Update Project</button>

</form>
</div>

<%- include("partials/footer") %>