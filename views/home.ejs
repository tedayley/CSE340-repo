<%- include("partials/header", { title }) %>

<section class="hero">
    <div class="container hero-content">
        <div class="hero-visual" aria-label="Education logo">
            <img
                class="hero-logo"
                src="/images/education.svg"
                alt="Education logo"
            >
        </div>

        <div class="hero-copy">
            <p class="eyebrow">Connect. Serve. Make a difference.</p>

            <h1>
                Find meaningful ways to serve your community.
            </h1>

            <p class="hero-text">
                Service Network helps people discover organizations and
                service projects where their time and talents can make
                a real difference.
            </p>

            <div class="button-group">
                <a class="button button-primary" href="/projects">
                    Explore Projects
                </a>

                <a class="button button-secondary" href="/organizations">
                    View Organizations
                </a>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">

        <div class="section-heading">
            <p class="eyebrow">What we offer</p>

            <h2>
                Service made easier
            </h2>

            <p>
                Explore opportunities based on the kind of impact
                you want to make.
            </p>
        </div>

        <div class="card-grid">

            <article class="card">
                <div class="card-icon">01</div>

                <h3>Organizations</h3>

                <p>
                    Learn about organizations working to improve
                    communities and support important causes.
                </p>

                <a href="/organizations">
                    Explore organizations &rarr;
                </a>
            </article>

            <article class="card">
                <div class="card-icon">02</div>

                <h3>Service Projects</h3>

                <p>
                    Discover projects that turn your time, skills,
                    and energy into meaningful service.
                </p>

                <a href="/projects">
                    View projects &rarr;
                </a>
            </article>

            <article class="card">
                <div class="card-icon">03</div>

                <h3>Categories</h3>

                <p>
                    Browse service opportunities by focus area
                    to find something that fits your interests.
                </p>

                <a href="/categories">
                    Browse categories &rarr;
                </a>
            </article>

        </div>

    </div>
</section>

<%- include("partials/footer") %>