<%- include("partials/header", { title }) %>

<section class="page-banner">
    <div class="container">

        <p class="eyebrow">Get involved</p>

        <h1>Service Projects</h1>

        <p>
            Find practical opportunities to use your time and
            talents to help others.
        </p>

    </div>
</section>

<section class="section">
    <div class="container">

        <div class="project-list">

            <article class="project-card">

                <div class="project-number">
                    01
                </div>

                <div>
                    <span class="tag">
                        Environmental
                    </span>

                    <h2>
                        Community Park Cleanup
                    </h2>

                    <p>
                        Help restore a local park by removing litter,
                        clearing trails, and improving shared outdoor spaces.
                    </p>

                    <p class="project-meta">
                        Saturday &bull; 9:00 AM &bull; 3 hours
                    </p>
                </div>

            </article>

            <article class="project-card">

                <div class="project-number">
                    02
                </div>

                <div>
                    <span class="tag">
                        Educational
                    </span>

                    <h2>
                        After-School Tutoring
                    </h2>

                    <p>
                        Work with students who need extra support with
                        reading, mathematics, and homework.
                    </p>

                    <p class="project-meta">
                        Tuesdays &bull; 4:00 PM &bull; 2 hours
                    </p>
                </div>

            </article>

            <article class="project-card">

                <div class="project-number">
                    03
                </div>

                <div>
                    <span class="tag">
                        Community Service
                    </span>

                    <h2>
                        Neighborhood Food Drive
                    </h2>

                    <p>
                        Sort donations and prepare food boxes for
                        families in the local community.
                    </p>

                    <p class="project-meta">
                        Saturday &bull; 10:00 AM &bull; 3 hours
                    </p>
                </div>

            </article>

        </div>

    </div>
</section>

<%- include("partials/footer") %>