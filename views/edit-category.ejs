<%- include("partials/header", { title }) %>

<section class="page-banner">
    <div class="container">
        <p class="eyebrow">Service Project</p>
        <h1>Edit Category</h1>
        <p>Update the name of this service project category.</p>
    </div>
</section>

<main class="container">
    <form class="edit-project-form" action="/edit-category/<%= category.category_id %>" method="POST">

```
    <label for="name">Category Name</label>

    <input
        type="text"
        id="name"
        name="name"
        value="<%= category.name || "" %>"
        maxlength="100"
        required
    >

    <% if (typeof error !== "undefined") { %>
        <p class="form-error"><%= error %></p>
    <% } %>

    <button type="submit">Update Category</button>

</form>
```

</main>

<%- include("partials/footer") %>
