<%- include("partials/header", { title }) %>

<section class="page-banner">
    <div class="container">
        <p class="eyebrow">Service Project</p>
        <h1>Edit Category</h1>
        <p>Update the name of this service project category.</p>
    </div>
</section>

<div class="container">
    <form class="edit-project-form" action="/edit-category/<%= category.category_id %>" method="POST">
    <h1>Edit Category</h1>

    <label for="name">Category Name</label>

    <input
        type="text"
        id="name"
        name="name"
        value="<%= category.name || "" %>"
        minlength="3"
        maxlength="100"
        required
    >

    <% if (typeof error !== "undefined") { %>
        <p class="form-error" role="alert"><%= error %></p>
    <% } %>

    <button class="button button-primary" type="submit">Update Category</button>

</form>

</div>

<%- include("partials/footer") %>
