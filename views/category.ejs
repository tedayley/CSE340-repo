<%- include("partials/header", { title }) %>

<section class="page-banner">
    <div class="container">
        <p class="eyebrow">Service Categories</p>
        <h1><%= category.name %></h1>
        <p>
            <a class="button button-secondary" href="/edit-category/<%= category.category_id %>">Edit Category</a>
        </p>
        <form class="inline-form" action="/delete-category/<%= category.category_id %>" method="POST" onsubmit="return confirm('Delete this category? Its project assignments will also be removed.');">
            <button class="button button-danger" type="submit">Delete Category</button>
        </form>
        <p>
            Explore service projects in this category.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="project-list">
<% projects.forEach((project, index) => { %>
            <article class="project-card">
                <div class="project-number">
                    <%= String(index + 1).padStart(2, "0") %>
                </div>

                <div>
                    <span class="tag">
                        <%= project.organization_name %>
                    </span>

                    <h2>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h2>

                    <p>
                        <%= project.description %>
                    </p>

                    <p class="project-meta">
                        <%= project.date.toLocaleDateString("en-US", {
                            weekday: "long",
                            month: "long",
                            day: "numeric",
                            year: "numeric"
                        }) %>
                        &bull;
                        <%= project.location %>
                    </p>
                </div>
            </article>
<% }) %>
        </div>
    </div>
</section>

<%- include("partials/footer") %>