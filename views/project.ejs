<%- include("partials/header", { title }) %>

<section class="page-banner">

    <div class="container">

        <p class="eyebrow">Service Project</p>

        <h1><%= project.title %></h1>

        <p>
            An opportunity to make a difference in your community.
        </p>

    </div>

</section>

<section class="section">

    <div class="container">

        <article class="project-card">

            <div>

                <span class="tag">
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </span>

                <h2><%= project.title %></h2>

                <p>
                    <%= project.description %>
                </p>

                <p class="project-meta">
                    <%= project.date.toLocaleDateString("en-US", {
                        weekday: "long",
                        month: "long",
                        day: "numeric",
                        year: "numeric"
                    }) %>
                    &bull;
                    <%= project.location %>
                </p>

            </div>

        </article>

    </div>

</section>

<%- include("partials/footer") %>