<%- include("partials/header", { title }) %>

<section class="page-banner">

    <div class="container">

        <p class="eyebrow">Service Project</p>

        <h1><%= project.title %></h1>

        <p>
            An opportunity to make a difference in your community.
        </p>

    </div>

</section>

<section class="section">

    <div class="container">

        <article class="project-card project-details-card">
            <div class="project-main">
                <div class="project-tags">
                <span class="tag">
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </span>

                <% categories.forEach((category) => { %>
                    <span class="tag">
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </span>
                <% }) %>
                </div>

                <h2><%= project.title %></h2>

                <p class="project-description">
                    <%= project.description %>
                </p>
            </div>

            <aside class="project-sidebar" aria-label="Project details and actions">
                <div class="project-facts">
                    <p class="project-meta">
                        <strong>Date</strong>
                    <%= project.date.toLocaleDateString("en-US", {
                        weekday: "long",
                        month: "long",
                        day: "numeric",
                        year: "numeric"
                    }) %>
                    </p>
                    <p class="project-meta">
                        <strong>Location</strong>
                        <%= project.location %>
                    </p>
                </div>

                <% if (user) { %>
                    <% if (isVolunteering) { %>
                        <p>You are volunteering for this project.</p>
                        <form class="inline-form" action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                            <button class="button button-danger" type="submit">Remove Me</button>
                        </form>
                    <% } else { %>
                        <form class="inline-form" action="/project/<%= project.project_id %>/volunteer" method="POST">
                            <button class="button button-primary" type="submit">Volunteer for This Project</button>
                        </form>
                    <% } %>
                <% } %>

                <% if (user && user.role_name === "admin") { %>
                    <div class="button-group project-actions">
                        <a class="button button-secondary" href="/edit-project/<%= project.project_id %>">
                            Edit Project Details
                        </a>
                        <a class="button button-primary" href="/edit-project/<%= project.project_id %>/categories">
                            Manage Categories
                        </a>
                        <form class="inline-form" action="/delete-project/<%= project.project_id %>" method="POST" onsubmit="return confirm('Delete this project?');">
                            <button class="button button-danger" type="submit">Delete Project</button>
                        </form>
                    </div>
                <% } %>
            </aside>
        </article>

    </div>

</section>

<%- include("partials/footer") %>