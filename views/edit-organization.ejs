<%- include("partials/header", { title }) %>

<div class="container">
    <form class="edit-project-form" action="/edit-organization/<%= organization.organization_id %>" method="POST">
        <h1>Edit Organization</h1>

        <% if (typeof error !== "undefined") { %>
            <p class="form-error" role="alert"><%= error %></p>
        <% } %>

        <label for="name">Organization Name</label>
        <input id="name" name="name" value="<%= organization.name || "" %>" minlength="3" maxlength="150" required>

        <label for="description">Description</label>
        <textarea id="description" name="description" minlength="10" required><%= organization.description || "" %></textarea>

        <label for="contact_email">Contact Email</label>
        <input type="email" id="contact_email" name="contact_email" value="<%= organization.contact_email || "" %>" maxlength="255" required>

        <label for="logo_filename">Logo Filename</label>
        <input id="logo_filename" name="logo_filename" value="<%= organization.logo_filename || "" %>" pattern="[A-Za-z0-9._-]+" maxlength="255" required>

        <button type="submit">Update Organization</button>
    </form>
</div>

<%- include("partials/footer") %>